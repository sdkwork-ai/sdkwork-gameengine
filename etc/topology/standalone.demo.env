# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_games_demo`
# and a dedicated Redis logical DB index so that no cache key ever collides with another
# shared-redis environment.
SDKWORK_GAMEENGINE_DEPLOYMENT_PROFILE=standalone
SDKWORK_GAMEENGINE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_GAMEENGINE_PROFILE_ID=standalone.demo
SDKWORK_GAMEENGINE_APPLICATION_PUBLIC_HTTP_URL=https://gameengine-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GAMEENGINE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Isolation: dedicated Redis logical DB index on the shared Redis so hardcoded service prefixes
# never collide with dev/test/staging/prod. Dedicated database schema/user `sdkwork_games_demo`.
SDKWORK_GAMEENGINE_REDIS_URL=redis://127.0.0.1:6379/9
SDKWORK_GAMEENGINE_REDIS_ENABLED=true
SDKWORK_GAMES_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
SDKWORK_GAMES_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
VITE_SDKWORK_GAMES_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
SDKWORK_CORS_ALLOWED_ORIGINS=https://gameengine-demo.sdkwork.com,http://gameengine-demo.sdkwork.com,https://gameengine-demo.birdcoder.com,http://gameengine-demo.birdcoder.com,https://gameengine-demo.dtupay.com,http://gameengine-demo.dtupay.com,https://gameengine-demo.noaper.com,http://gameengine-demo.noaper.com,https://gameengine-demo.sdkwork.cn,http://gameengine-demo.sdkwork.cn,https://gameengine-demo.birdcoder.cn,http://gameengine-demo.birdcoder.cn,https://gameengine-demo.dtupay.cn,http://gameengine-demo.dtupay.cn,https://gameengine-demo.noaper.cn,http://gameengine-demo.noaper.cn,https://gameengine-demo.skubc.com,http://gameengine-demo.skubc.com,https://gameengine-demo.skubc.cn,http://gameengine-demo.skubc.cn,https://gameengine-demo.zowalk.com,http://gameengine-demo.zowalk.com,https://gameengine-demo.zowalk.cn,http://gameengine-demo.zowalk.cn,https://gameengine-demo.offer86.com,http://gameengine-demo.offer86.com,https://gameengine-demo.offer86.cn,http://gameengine-demo.offer86.cn,https://gameengine-demo.86offer.com,http://gameengine-demo.86offer.com,https://gameengine-demo.86offer.cn,http://gameengine-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
