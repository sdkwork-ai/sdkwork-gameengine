# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_games_demo`
# and a dedicated Redis logical DB index so that no cache key ever collides with another
# shared-redis environment.
SDKWORK_GAMEENGINE_DEPLOYMENT_PROFILE=standalone
SDKWORK_GAMEENGINE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_GAMEENGINE_PROFILE_ID=standalone.demo
SDKWORK_GAMEENGINE_APPLICATION_PUBLIC_HTTP_URL=https://gameengine-demo.sdkwork.com

# Isolation: dedicated Redis logical DB index on the shared Redis so hardcoded service prefixes
# never collide with dev/test/staging/prod. Dedicated database schema/user `sdkwork_games_demo`.
SDKWORK_GAMEENGINE_REDIS_URL=redis://127.0.0.1:6379/9
SDKWORK_GAMEENGINE_REDIS_ENABLED=true
SDKWORK_GAMES_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
SDKWORK_GAMES_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
VITE_SDKWORK_GAMES_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
