SDKWORK_GAMEENGINE_ENVIRONMENT=production
SDKWORK_CORS_ALLOWED_ORIGINS=https://gameengine.sdkwork.com,https://gameengine.birdcoder.com,https://gameengine.dtupay.com,https://gameengine.noaper.com,https://gameengine.sdkwork.cn,https://gameengine.birdcoder.cn,https://gameengine.dtupay.cn,https://gameengine.noaper.cn,https://gameengine.skubc.com,https://gameengine.skubc.cn,https://gameengine.zowalk.com,https://gameengine.zowalk.cn,https://gameengine.offer86.com,https://gameengine.offer86.cn,https://gameengine.86offer.com,https://gameengine.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,dsh-app://app,tauri://localhost,https://servicewechat.com
