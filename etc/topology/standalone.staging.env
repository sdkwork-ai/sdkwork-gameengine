# Bootstrap profile standalone.staging — replace with application-specific values.
SDKWORK_GAMEENGINE_DEPLOYMENT_PROFILE=standalone
SDKWORK_GAMEENGINE_ENVIRONMENT=staging
SDKWORK_GAMEENGINE_PROFILE_ID=standalone.staging
SDKWORK_GAMEENGINE_APPLICATION_PUBLIC_HTTP_URL=https://gameengine-staging.sdkwork.com
